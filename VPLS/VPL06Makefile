CC = g++
FLAGS = -Wall -I include/

all: vpl_execution

build/Ponto.o: src/entidades/Ponto.cpp include/Ponto.hpp
    $(CC) $(FLAGS) -c src/entidades/Ponto.cpp -o build/Ponto.o

build/Circulo.o: src/entidades/Circulo.cpp include/Circulo.hpp
	$(CC) $(FLAGS) -c src/entidades/Circulo.cpp -o build/Circulo.o

build/main.o: src/main.cpp
	$(CC) $(FLAGS) -c src/main.cpp -o build/main.o

vpl_execution: build/Ponto.o build/Circulo.o build/main.o
	$(CC) build/Ponto.o build/Circulo.o build/main.o -o vpl_execution

clean:
	rm -f build/*.o vpl_execution